{
  "name": "@qme/sdk",
  "version": "0.1.0",
  "description": "Script-side helpers for Qme jobs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qme/client": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santistebanc/Qme.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
