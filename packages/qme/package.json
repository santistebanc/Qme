{
  "name": "qme",
  "version": "0.1.0",
  "description": "TypeScript-first local job queue and dashboard for trusted apps.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "qme": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qme/client": "0.1.0",
    "@qme/core": "0.1.0",
    "@qme/sdk": "0.1.0",
    "@qme/server": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "keywords": [
    "queue",
    "jobs",
    "workflow",
    "sqlite",
    "dashboard",
    "scraping"
  ],
  "homepage": "https://santistebanc.github.io/Qme/",
  "bugs": {
    "url": "https://github.com/santistebanc/Qme/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santistebanc/Qme.git",
    "directory": "packages/qme"
  },
  "license": "MIT"
}
